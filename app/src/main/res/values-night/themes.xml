<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Komik" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
        <item name="android:fontFamily">@font/interreguler</item>

        <item name="colorPrimary">@color/primary_button</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorOnBackground">@color/dark_onBackground</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_onSurface</item>

        <item name="android:textColor">@color/white</item>

    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/interextra</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme.SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/gray_400</item>
        <item name="android:tint">@color/white</item>
    </style>

    <style name="MyCustomSearchBar" parent="Widget.Material3.SearchBar">
        <item name="backgroundTint">@color/bottom_navbar</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="Costumtitle">
        <item name="android:fontFamily">@font/intermedium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Subtitle">
        <item name="android:fontFamily">@font/interreguler</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ProgressCircular" parent="Widget.Material3.CircularProgressIndicator">

    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_button</item>
    </style>


<!--    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">-->
<!--        <item name="android:color">@color/primary_button</item>-->
<!--    </style>-->
</resources>