<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Komik" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">@font/interreguler</item>
<!--         Warna utama brand kamu. Biasanya buat tombol, header, atau elemen penting lainnya.-->
        <item name="colorPrimary">@color/light_primary</item>
<!--        Warna teks atau ikon yang ada di atas colorPrimary.-->
        <item name="colorOnPrimary">@color/light_onPrimary</item>
<!--        Warna "permukaan" komponen seperti Card, Bottom Sheet, Menu.-->
        <item name="android:colorBackground">@color/background_utama</item>
<!--        Warna teks atau ikon di atas colorSurface.-->
        <item name="colorOnBackground">@color/white</item>
<!--&lt;!&ndash;        Warna latar belakang utama aplikasi.&ndash;&gt;-->
<!--        <item name="colorSurface">@color/light_surface</item>-->
<!--         Warna teks di atas colorBackground.-->
        <item name="colorOnSurface">@color/dark_onSurface</item>
        <item name="android:textColor">@color/white</item>

<!--        <item name="android:statusBarColor">@color/bottom_navbar</item>-->
<!--        <item name="android:windowLightStatusBar">false</item>-->

<!--        <item name="android:navigationBarColor">@color/bottom_navbar</item>-->
<!--        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>-->




    </style>

    <style name="MyCustomSearchBar" parent="Widget.Material3.SearchBar">
        <item name="backgroundTint">@color/bottom_navbar</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="Costumtitle">
        <item name="android:fontFamily">@font/intermedium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Subtitle">
        <item name="android:fontFamily">@font/interreguler</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ProgressCircular" parent="Widget.Material3.CircularProgressIndicator">

    </style>

    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_button</item>
    </style>

    <style name="Theme.Komik" parent="Base.Theme.Komik" />
</resources>