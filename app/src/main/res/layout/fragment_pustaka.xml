<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aurora_bg"
    tools:context=".ui.pustaka.PustakaFragment">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/appbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="?attr/actionBarSize"
                app:menu="@menu/menu_pustaka"
                app:title="Pustaka Saya"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
                app:titleTextColor="@color/white" />

            <TextView
                android:id="@+id/tvTotalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pustaka_badge"
                android:fontFamily="@font/intersemi"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="0 Komik"
                android:textColor="#A5B4FC"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search & Filter Controls -->
    <LinearLayout
        android:id="@+id/searchFilterLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout2">

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/search_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/baseline_search_24"
                app:tint="@color/gray_400" />

            <EditText
                android:id="@+id/etSearchPustaka"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/interreguler"
                android:hint="Cari judul di pustaka..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_400"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/baseline_close_24"
                android:visibility="gone"
                app:tint="@color/gray_400" />
        </LinearLayout>

        <!-- Filter & Sort Bottom Sheet Button -->
        <FrameLayout
            android:id="@+id/btnOpenFilter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/search_background"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/baseline_filter_list_24"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <!-- Quick Status Filter Chips (Horizontal Shelf) -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/searchFilterLayout">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quickChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuickSemua"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Semua"
                android:textColor="@color/white"
                app:chipBackgroundColor="#23262B" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuickReading"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sedang Dibaca"
                android:textColor="@color/white"
                app:chipBackgroundColor="#23262B" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuickPlan"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rencana Baca"
                android:textColor="@color/white"
                app:chipBackgroundColor="#23262B" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuickCompleted"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tamat"
                android:textColor="@color/white"
                app:chipBackgroundColor="#23262B" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipQuickOnHold"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ditunda"
                android:textColor="@color/white"
                app:chipBackgroundColor="#23262B" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Modern Controls Bar (Grid Toggle & Sort) -->
    <LinearLayout
        android:id="@+id/controlBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipsScroll">

        <!-- Grid 2 / Grid 3 Switcher -->
        <LinearLayout
            android:id="@+id/btnToggleGrid"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pustaka_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/ivGridIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/squares_four"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvGridLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/intersemi"
                android:text="Grid 3"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Sort Option Button -->
        <LinearLayout
            android:id="@+id/btnSortPustaka"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pustaka_pill_btn"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_sort_arrows"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvSortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/intersemi"
                android:text="Urutkan"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading Bar -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlBarLayout"
        app:trackColor="@color/surface_light"
        app:trackCornerRadius="4dp"
        app:trackThickness="3dp" />

    <!-- SwipeRefreshLayout wrapping list -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/loading">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listPustaka"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingBottom="90dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Modern Rich Empty State -->
    <LinearLayout
        android:id="@+id/placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlBarLayout">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.85"
            android:src="@drawable/bookmark_simple"
            app:tint="@color/primary_button" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/interbold"
            android:text="Pustaka Masih Kosong"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/interreguler"
            android:gravity="center"
            android:text="Tandai komik favorit dari daftar ekstensi untuk menyimpannya di sini."
            android:textColor="@color/gray_400"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/btnExplore"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pustaka_explore_btn"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="22dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/baseline_search_24"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/interbold"
                android:text="Jelajahi Komik"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Bulk Action Bar (Pill elevated at bottom) -->
    <LinearLayout
        android:id="@+id/bulkActionBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/pill_floating_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/intersemi"
            android:text="0 dipilih"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnMoveShelf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/intersemi"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="Pindah Rak"
            android:textColor="#818CF8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnDeleteSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/interbold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="Hapus"
            android:textColor="@color/red"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnCancelBulk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/intersemi"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:text="Batal"
            android:textColor="@color/gray_400"
            android:textSize="13sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
