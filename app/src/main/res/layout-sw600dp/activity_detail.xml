<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_utama"
    tools:context=".ui.pages.detail.DetailActivity">

    <!-- Pinned Top AppBar for Tablet -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_utama"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentScrim="@color/bottom_navbar"
            app:statusBarScrim="@color/background_utama"
            app:titleEnabled="false">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@null">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingEnd="16dp">

                    <ImageButton
                        android:id="@+id/back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_background_opacity"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="8dp"
                        android:src="@drawable/caret_left"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvToolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:layout_toEndOf="@+id/back"
                        android:layout_toStartOf="@+id/toolbarActions"
                        android:ellipsize="end"
                        android:fontFamily="@font/interbold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="Judul Komik" />

                    <LinearLayout
                        android:id="@+id/toolbarActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShareToolbar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/btn_background_opacity"
                            android:clickable="true"
                            android:clipToOutline="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="8dp"
                            android:src="@drawable/share_forward_box_fill"
                            app:tint="@color/white" />

                        <ImageButton
                            android:id="@+id/btnReportToolbar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/btn_background_opacity"
                            android:clickable="true"
                            android:clipToOutline="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="8dp"
                            android:src="@drawable/ic_report_problem"
                            app:tint="@color/calm_rose" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Two-Pane Split View for Tablet (Guideline 38%) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_utama">

            <!-- Vertical Guideline at 38% -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelinePane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.38" />

            <!-- ============================================== -->
            <!-- PANE KIRI (0% - 38%): Detail Info & Actions   -->
            <!-- ============================================== -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:scrollbars="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guidelinePane"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="24dp">

                    <!-- Header Banner & Overlay -->
                    <FrameLayout
                        android:id="@+id/frameLayout2"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@drawable/corner_gambar"
                        android:clipToOutline="true">

                        <ImageView
                            android:id="@+id/banner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/background_cover_image" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="bottom"
                            android:background="#99121212" />
                    </FrameLayout>

                    <!-- Poster Cover Thumbnail (Floating over Banner) -->
                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="120dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="-70dp"
                        android:background="@drawable/corner_gambar"
                        android:clipToOutline="true"
                        android:elevation="8dp"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/placeholder" />

                    <!-- Comic Title -->
                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/interbold"
                        android:gravity="center"
                        android:maxLines="3"
                        android:text="Judul Komik"
                        android:textColor="@color/white"
                        android:textSize="18sp" />

                    <!-- Alternative Title / Author -->
                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/interreguler"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="Author / Alternative Title"
                        android:textColor="@color/gray_400"
                        android:textSize="12sp" />

                    <!-- Metadata Card (Status, Type, Rating) -->
                    <LinearLayout
                        android:id="@+id/CardInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/card"
                        android:gravity="center_vertical"
                        android:minHeight="54dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="8dp">

                        <!-- Status -->
                        <LinearLayout
                            android:id="@+id/layoutStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/interbold"
                                android:maxLines="1"
                                android:text="Ongoing"
                                android:textColor="@color/text_emerald_400"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textView8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/interreguler"
                                android:text="Status"
                                android:textColor="@color/gray_400"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Divider 1 -->
                        <View
                            android:id="@+id/divider"
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#2E333C" />

                        <!-- Type -->
                        <LinearLayout
                            android:id="@+id/layoutType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tipe"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/interbold"
                                android:maxLines="1"
                                android:text="Manhwa"
                                android:textColor="@color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/textView10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/interreguler"
                                android:text="Tipe"
                                android:textColor="@color/gray_400"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <!-- Divider 2 -->
                        <View
                            android:id="@+id/divider2"
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="#2E333C" />

                        <!-- Rating -->
                        <LinearLayout
                            android:id="@+id/layoutRating"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivStarRating"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:layout_marginEnd="3dp"
                                    android:src="@drawable/baseline_star_24"
                                    app:tint="@color/color_star" />

                                <TextView
                                    android:id="@+id/tvRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/interbold"
                                    android:text="8.5"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/interreguler"
                                android:text="Rating"
                                android:textColor="@color/gray_400"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Main Action Buttons -->
                    <LinearLayout
                        android:id="@+id/layoutActionButtons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <!-- Primary CTA (Baca / Lanjut) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBaca"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:backgroundTint="#4F46E5"
                            android:fontFamily="@font/interbold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Mulai Baca Ch. 1"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/play_circle_fill__1_"
                            app:iconGravity="textStart"
                            app:iconSize="20dp"
                            app:iconTint="@color/white" />

                        <!-- Secondary Actions Dock -->
                        <LinearLayout
                            android:id="@+id/layoutSecondaryActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:weightSum="4">

                            <!-- Pustaka -->
                            <LinearLayout
                                android:id="@+id/btnBookmarkAction"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_detail_action_btn"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:id="@+id/button2"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/bookmark_simple"
                                    app:tint="@color/white" />

                                <TextView
                                    android:id="@+id/tvBookmarkLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Pustaka"
                                    android:textColor="@color/grey_300"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Migrasi -->
                            <LinearLayout
                                android:id="@+id/btnMigrate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_detail_action_btn"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/loop_right_line"
                                    app:tint="@color/mint_teal" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Migrasi"
                                    android:textColor="@color/grey_300"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bagikan -->
                            <LinearLayout
                                android:id="@+id/share"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_detail_action_btn"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/share_forward_box_fill"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Bagikan"
                                    android:textColor="@color/grey_300"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Lapor -->
                            <LinearLayout
                                android:id="@+id/btnReport"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_detail_action_btn"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingVertical="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_report_problem"
                                    app:tint="@color/calm_rose" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Lapor"
                                    android:textColor="@color/grey_300"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Genre Horizontal Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/interbold"
                        android:text="Genre"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/genre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        tools:itemCount="4"
                        tools:listitem="@layout/card_genre" />

                    <!-- Synopsis Card -->
                    <LinearLayout
                        android:id="@+id/layoutSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/interbold"
                            android:text="Sinopsis"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/sinopsis"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/interreguler"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="3"
                            android:text="Memuat sinopsis komik..."
                            android:textColor="@color/grey_300"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/selengkap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/intersemi"
                            android:text="Lihat Selengkapnya"
                            android:textColor="@color/text_violet_400"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ============================================== -->
            <!-- PANE KANAN (38% - 100%): Chapters & Filters   -->
            <!-- ============================================== -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/guidelinePane"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Dark-Mode Card Container for Chapters (#1C1C28) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1C1C28"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#2A2A3C"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Chapter Section Header Controls -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView12"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/interbold"
                                android:text="Daftar Chapter"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <!-- Batch Download Button -->
                            <LinearLayout
                                android:id="@+id/btnBatchDownload"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/card"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/baseline_download_24"
                                    app:tint="@color/text_violet_400" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Unduh Batch"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvBatchVipTag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/badge_role_vip"
                                    android:fontFamily="@font/interbold"
                                    android:paddingHorizontal="4dp"
                                    android:paddingVertical="1dp"
                                    android:text="VIP"
                                    android:textColor="#FBBF24"
                                    android:textSize="9sp" />
                            </LinearLayout>

                            <!-- Sort Chapter Toggle Button -->
                            <LinearLayout
                                android:id="@+id/btnSortChapter"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/card"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="12dp">

                                <ImageView
                                    android:id="@+id/ivSortChapter"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_sort_arrows"
                                    app:tint="@color/text_violet_400" />

                                <TextView
                                    android:id="@+id/tvSortChapter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Terbaru"
                                    android:textColor="@color/white"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Search Chapter Bar -->
                        <LinearLayout
                            android:id="@+id/layoutSearchChapter"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_search_detail"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/baseline_search_24"
                                app:tint="@color/gray_400" />

                            <EditText
                                android:id="@+id/etSearchChapter"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:fontFamily="@font/interreguler"
                                android:hint="Cari nomor / judul chapter..."
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textColorHint="@color/gray_400"
                                android:textSize="13sp" />

                            <ImageView
                                android:id="@+id/btnClearSearch"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:src="@drawable/baseline_close_24"
                                android:visibility="gone"
                                app:tint="@color/gray_400" />
                        </LinearLayout>

                        <!-- Filter Chips & Jump First Chapter -->
                        <LinearLayout
                            android:id="@+id/layoutChapterFilters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <HorizontalScrollView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:scrollbars="none">

                                <com.google.android.material.chip.ChipGroup
                                    android:id="@+id/chipGroupChapterFilter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    app:singleLine="true"
                                    app:singleSelection="true">

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipFilterAll"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:checked="true"
                                        android:fontFamily="@font/intersemi"
                                        android:text="Semua"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        app:chipBackgroundColor="#23262B"
                                        app:chipStrokeColor="#3A404D"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipFilterUnread"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/intersemi"
                                        android:text="Belum Dibaca"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        app:chipBackgroundColor="#23262B"
                                        app:chipStrokeColor="#3A404D"
                                        app:chipStrokeWidth="1dp" />

                                    <com.google.android.material.chip.Chip
                                        android:id="@+id/chipFilterOffline"
                                        style="@style/Widget.Material3.Chip.Filter"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/intersemi"
                                        android:text="Offline"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        app:chipBackgroundColor="#23262B"
                                        app:chipStrokeColor="#3A404D"
                                        app:chipStrokeWidth="1dp" />

                                </com.google.android.material.chip.ChipGroup>
                            </HorizontalScrollView>

                            <!-- Ke Ch. Awal Button -->
                            <LinearLayout
                                android:id="@+id/btnJumpFirstChapter"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/card"
                                android:clickable="true"
                                android:clipToOutline="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="4dp"
                                    android:src="@drawable/caret_left"
                                    app:tint="@color/text_violet_400" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/intersemi"
                                    android:text="Ke Ch. Awal"
                                    android:textColor="@color/white"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Shimmer Skeleton Loading Placeholder -->
                        <LinearLayout
                            android:id="@+id/layoutChapterSkeleton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <include layout="@layout/item_chapter_skeleton" />
                            <include layout="@layout/item_chapter_skeleton" />
                            <include layout="@layout/item_chapter_skeleton" />
                            <include layout="@layout/item_chapter_skeleton" />
                            <include layout="@layout/item_chapter_skeleton" />
                        </LinearLayout>

                        <!-- Empty State -->
                        <TextView
                            android:id="@+id/layoutEmptyChapter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:padding="16dp"
                            android:text="Chapter tidak ditemukan"
                            android:textColor="@color/gray_400"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <!-- Chapter RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/chapter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="8"
                            tools:listitem="@layout/card_chapter" />

                        <!-- Loading more indicator -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/loadingMoreChapter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginVertical="16dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/brand"
                            app:indicatorSize="26dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Hidden Extended FAB to satisfy ViewBinding -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/baca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:visibility="gone" />

    <!-- Center Loading Indicator -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/primary_button" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
