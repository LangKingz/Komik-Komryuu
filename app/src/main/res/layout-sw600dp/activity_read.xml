<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_utama"
    tools:context=".ui.pages.read.ReadActivity">

    <!-- Main Reading RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp" />

    <!-- Thin Linear Progress Indicator at the top (2dp) -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/readingProgressBar"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:max="100"
        android:progress="0"
        app:indicatorColor="@color/brand"
        app:trackColor="#25FFFFFF" />

    <!-- Floating Page Pill in Bottom-Right Corner -->
    <LinearLayout
        android:id="@+id/pillPageInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_floating_hud"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvQuickChapterInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/intersemi"
            android:text="Ch. -- • 1/1"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fullscreen HUD Container -->
    <FrameLayout
        android:id="@+id/chapterControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Floating Top Bar (wider margins for tablet) -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="48dp"
            android:layout_marginTop="52dp"
            android:background="@drawable/bg_floating_hud"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_read_btn"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="8dp"
                android:src="@drawable/caret_left"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/judulManhwa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="@font/interbold"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvChapterSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/interreguler"
                    android:maxLines="1"
                    android:text="Chapter --"
                    android:textColor="@color/gray_400"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_read_btn"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="9dp"
                android:src="@drawable/bookmark_simple"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_read_btn"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:padding="10dp"
                android:src="@drawable/loop_right_line"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Floating Bottom Bar (wider margins for tablet) -->
        <LinearLayout
            android:id="@+id/bottom_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="48dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_floating_hud_bottom"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp">

            <com.google.android.material.slider.Slider
                android:id="@+id/slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stepSize="1.0"
                android:value="0.0"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                app:thumbColor="@color/brand"
                app:trackColorActive="@color/brand"
                app:trackColorInactive="#44FFFFFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/btnPrevChapter"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_read_btn"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/caret_left"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/intersemi"
                        android:text="Prev"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnNextChapter"
                    app:layout_constraintStart_toEndOf="@+id/btnPrevChapter"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/daftarChapter"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_read_btn"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp"
                        android:src="@drawable/baseline_filter_list_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/PageNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="14dp"
                        android:fontFamily="@font/intersemi"
                        android:text="1/1"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_read_btn"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp"
                        android:src="@drawable/baseline_settings_24"
                        app:tint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNextChapter"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_read_btn_accent"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/intersemi"
                        android:text="Next"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/caret_right"
                        app:tint="@color/white" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Full-screen Loading Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/loading"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:backgroundTint="@color/bottom_navbar"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/brand" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/intersemi"
                android:text="Memuat..."
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>